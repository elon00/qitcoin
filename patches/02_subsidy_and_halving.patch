@@ -1153,9 +1153,10 @@ CAmount GetBlockSubsidy(int nHeight, const Consensus::Params& consensusParams)
 {
     int halvings = nHeight / consensusParams.nSubsidyHalvingInterval;
     // Force block reward to zero when right shift is undefined.
-    if (halvings >= 64)
+    if (halvings >= 38)
         return 0;
 
-    CAmount nSubsidy = 50 * COIN;
+    // Qitcoin: 250,000 QTC initial block reward, halving every 2,000,000 blocks (~3.8 yrs @ 1 min blocks)
