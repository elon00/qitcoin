# Qitcoin Configuration & API Key Environment Template
# COPY this file to .env and insert your real keys. NEVER commit .env to GitHub!

# 1. Artificial Intelligence LLM Providers (for Multimodal Agentics)
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# 2. Blockchain RPC Providers & Cross-Chain Gateways
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key
BITCOIN_RPC_URL=http://user:password@127.0.0.1:8332
ALGORAND_ALGOD_TOKEN=your_algod_token
ALGORAND_ALGOD_SERVER=https://mainnet-api.algonode.cloud

# 3. Cross-Chain Bridge & Relayer Keys (NIST FIPS 204 PQC)
BRIDGE_RELAYER_PQC_SEED=<64-hex-chars-from-a-cryptographically-secure-32-byte-secret>
BRIDGE_OPERATOR_ADDRESS=Q1TrillionQitcoinGenesisDevKey888
EMERGENCY_CIRCUIT_BREAKER_KEY=your_multisig_secret_key

# 4. Qitcoin Node Configuration
QTC_NETWORK=regtest
QTC_P2P_PORT=19333
QTC_RPC_PORT=19332
QTC_RPC_USER=qtcadmin
QTC_RPC_PASSWORD=<generate-a-strong-random-password>
\n# Local-only secret editing. Keep 0 on public deployments.\nQTC_ALLOW_KEY_WRITES=0\n